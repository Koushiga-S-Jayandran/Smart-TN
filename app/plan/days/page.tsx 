import Link from "next/link";
import { redirect } from "next/navigation";
import { CATEGORIES, DISTRICTS } from "@/lib/data";

export default async function Step3({ searchParams }: { searchParams: Promise<{ district?: string; type?: string }> }) {
  const { district, type } = await searchParams;
  if (!district || !DISTRICTS.includes(district)) redirect("/plan");
  if (!CATEGORIES.some((c) => c.id === type)) redirect(`/plan/type?district=${district}`);

  return (
    <div className="mx-auto max-w-3xl px-4 py-10">
      <p className="text-sm text-red-900 font-semibold mb-2">Step 3 of 4 · Days</p>
      <Link href={`/plan/type?district=${district}`} className="text-sm text-red-900">← Change type</Link>
      <h1 className="text-2xl font-bold my-3">How many days?</h1>
      <div className="grid grid-cols-4 sm:grid-cols-7 gap-3">
        {[1, 2, 3, 4, 5, 6, 7].map((n) => (
          <Link key={n} href={`/plan/generate?district=${district}&type=${type}&days=${n}`}
            className="rounded-xl bg-white py-6 text-center shadow-sm hover:bg-red-900 hover:text-white transition">
            <div className="text-2xl font-bold">{n}</div>
            <div className="text-xs">{n === 1 ? "day" : "days"}</div>
          </Link>
        ))}
      </div>
    </div>
  );
}